// Flurtek CRM — modelo de dados da Fase 1.
// Convenções: ids cuid, datas em UTC, enums em português para coincidir com o funil do negócio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMERCIAL
  REPRESENTANTE
  LEITURA
}

enum LeadStage {
  NOVO
  QUALIFICADO
  COTACAO
  NEGOCIACAO
  FECHADO
  PERDIDO
  FRIO
}

enum Temperature {
  QUENTE
  MORNO
  FRIO
}

enum LeadSource {
  SITE_FORMULARIO
  CHAT_SITE
  SITE_LISTA_ESPERA
  WHATSAPP
  EMAIL
  MARKETPLACE
  GOOGLE_ADS
  REPRESENTANTE
  PROSPECCAO_IA
  MANUAL
}

enum Channel {
  WHATSAPP
  EMAIL
  CHAT_SITE
  TELEFONE
}

enum MessageAuthor {
  CLIENTE
  EQUIPE
  AGENTE
  SISTEMA
}

enum ConversationMode {
  AGENTE
  HUMANO
}

enum ActorType {
  USUARIO
  AGENTE
  SISTEMA
}

enum TaskStatus {
  ABERTA
  CONCLUIDA
  CANCELADA
}

enum AgentActionStatus {
  PENDENTE
  APROVADA
  REJEITADA
  EXECUTADA
  FALHOU
}

enum AutonomyLevel {
  AUTOMATICO
  APROVACAO
  HUMANO
}

enum DocStatus {
  RASCUNHO
  APROVADO
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(LEITURA)
  active       Boolean   @default(true)
  // Estados (UF) que o representante atende; vazio para os demais papéis.
  states       String[]  @default([])
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  leads             Lead[]             @relation("LeadOwner")
  tasks             Task[]
  events            LeadEvent[]
  decisions         AgentAction[]      @relation("ActionDecidedBy")
  auditLogs         AuditLog[]
  authorizedNumbers AuthorizedNumber[]

  @@index([role])
}

enum OrderStatus {
  ABERTO
  FATURADO
  PAGO
  CANCELADO
}

enum ChargeStatus {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
  ESTORNADA
}

enum FiscalStatus {
  PENDENTE
  EMITIDA
  ERRO
  CANCELADA
}

model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?  @unique
  segment   String?
  city      String?
  uf        String?
  website   String?
  ie        String?
  address   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  leads    Lead[]
  customer Customer?

  @@index([name])
  @@index([uf])
}

model Contact {
  id        String    @id @default(cuid())
  companyId String?
  name      String
  email     String?
  phone     String?
  // Telefone só com dígitos e DDI (ex.: 5554991268955), para achar o contato quando chega mensagem.
  phoneKey  String?
  jobTitle  String?
  // Pediu para não receber mais mensagens (sair, parar...). O executor nunca envia para quem tem isto.
  optOutAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads   Lead[]

  @@index([email])
  @@index([phone])
  @@index([phoneKey])
}

model Lead {
  id             String      @id @default(cuid())
  companyId      String?
  contactId      String?
  title          String
  stage          LeadStage   @default(NOVO)
  score          Int         @default(0)
  temperature    Temperature @default(FRIO)
  source         LeadSource  @default(MANUAL)
  sourceDetail   String?
  product        String?
  volume         String?
  estimatedValue Decimal?    @db.Decimal(12, 2)
  nextAction     String?
  lostReason     String?
  // Responsável: pessoa ou, se ownerId for nulo e agentOwned verdadeiro, o agente.
  ownerId        String?
  agentOwned     Boolean     @default(false)
  uf             String?
  city           String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  // Consentimento (LGPD): quando, para quê e de onde veio.
  consentAt      DateTime?
  consentText    String?
  consentSource  String?
  lastContactAt  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner         User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  events        LeadEvent[]
  tasks         Task[]
  conversations Conversation[]
  actions       AgentAction[]
  watches       OwnerWatch[]

  @@index([stage])
  @@index([ownerId])
  @@index([uf])
  @@index([createdAt])
}

model LeadEvent {
  id        String    @id @default(cuid())
  leadId    String
  actorType ActorType
  actorId   String?
  kind      String
  text      String
  meta      Json?
  createdAt DateTime  @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model Task {
  id         String     @id @default(cuid())
  leadId     String?
  assigneeId String?
  title      String
  dueAt      DateTime?
  status     TaskStatus @default(ABERTA)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  lead     Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status])
  @@index([dueAt])
}

model Conversation {
  id               String           @id @default(cuid())
  leadId           String?
  channel          Channel
  externalId       String?
  mode             ConversationMode @default(AGENTE)
  unread           Int              @default(0)
  // CLIENTE = conversa com lead/cliente; DONO = conversa com número autorizado (ordens e relatórios).
  kind             String           @default("CLIENTE")
  // Última mensagem recebida do cliente: define a janela de 24 h do WhatsApp para resposta livre.
  lastInboundAt    DateTime?
  // Última vez que o agente processou esta conversa. Se lastInboundAt for mais novo, há mensagem a tratar.
  agentProcessedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([channel, externalId])
  @@index([leadId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  author         MessageAuthor
  body           String
  meta           Json?
  // Id da mensagem no canal (idempotência) e estado de entrega: pendente, enviada, entregue, lida, falhou.
  externalId     String?       @unique
  status         String?
  error          String?
  // Quando o CRM recebeu. O horário do provedor (createdAt) vem em segundos e pode ser anterior ao processamento.
  receivedAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Cada coisa que o agente propõe ou faz. No modo "sugere e aprova", nada de saída é executado sem decisão humana.
model AgentAction {
  id             String            @id @default(cuid())
  leadId         String?
  tool           String
  kind           String
  input          Json?
  output         Json?
  draft          String?
  confidence     Int               @default(0)
  reason         String?
  status         AgentActionStatus @default(PENDENTE)
  decidedById    String?
  decidedAt      DateTime?
  executedAt     DateTime?
  conversationId String?
  error          String?
  createdAt      DateTime          @default(now())

  lead      Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  decidedBy User? @relation("ActionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([leadId])
}

model AutonomyPolicy {
  id          String        @id @default(cuid())
  task        String        @unique
  label       String
  level       AutonomyLevel
  updatedById String?
  updatedAt   DateTime      @updatedAt
}

model KnowledgeDoc {
  id        String    @id @default(cuid())
  title     String
  body      String
  status    DocStatus @default(RASCUNHO)
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id        String    @id @default(cuid())
  actorType ActorType
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime  @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// Configurações globais (ex.: agent.enabled = chave geral do agente).
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Cliente que já comprou. O ciclo de consumo alimenta os lembretes de recompra.
model Customer {
  id        String   @id @default(cuid())
  companyId String   @unique
  cycleDays Int      @default(30)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]
}

model Order {
  id         String      @id @default(cuid())
  customerId String
  product    String
  volume     String?
  value      Decimal?    @db.Decimal(12, 2)
  orderedAt  DateTime
  status     OrderStatus @default(ABERTO)
  notes      String?
  createdAt  DateTime    @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  charges    Charge[]
  fiscalDocs FiscalDoc[]

  @@index([customerId, orderedAt])
}

// Números que podem dar ordens ao agente (dono e gestores).
model AuthorizedNumber {
  id              String    @id @default(cuid())
  phoneKey        String    @unique
  name            String
  role            String    @default("GESTOR") // DONO ou GESTOR
  active          Boolean   @default(true)
  // Usuário do CRM em nome de quem as aprovações são registradas (precisa de permissão para revisar o agente).
  userId          String?
  verifiedAt      DateTime?
  verifyCodeHash  String?
  verifyExpiresAt DateTime?
  createdAt       DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Comando do dono que aguarda "CONFIRMO" (ações sensíveis em dois passos).
model OwnerCommand {
  id        String    @id @default(cuid())
  phoneKey  String
  kind      String
  payload   Json?
  summary   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phoneKey, createdAt])
}

// "Me avise quando esse cliente responder": uma notificação e encerra.
model OwnerWatch {
  id        String   @id @default(cuid())
  phoneKey  String
  leadId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, active])
}

// Tudo que chega de webhook, bruto, para auditoria e para ajustar o leitor com eventos reais.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  dedupeKey   String?   @unique
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([provider, createdAt])
}

// Idempotência dos formulários do site (reenvio do mesmo formulário não duplica lead).
model IntakeSubmission {
  id           String   @id @default(cuid())
  submissionId String   @unique
  form         String
  leadId       String?
  createdAt    DateTime @default(now())
}

// Cobrança de um pedido no gateway (Asaas). Valor e vencimento são decididos por uma pessoa.
model Charge {
  id          String       @id @default(cuid())
  orderId     String
  provider    String
  externalId  String?      @unique
  billingType String // PIX, BOLETO, CREDIT_CARD, UNDEFINED
  value       Decimal      @db.Decimal(12, 2)
  dueDate     DateTime
  status      ChargeStatus @default(PENDENTE)
  paymentUrl  String?
  pixPayload  String?
  paidAt      DateTime?
  paidValue   Decimal?     @db.Decimal(12, 2)
  createdById String?
  remindedAt  DateTime?
  error       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fiscalDocs FiscalDoc[]

  @@index([status, dueDate])
  @@index([orderId])
}

// Nota fiscal de um pedido. NF-e (produto) ou NFS-e (serviço), emitida por um provedor fiscal.
model FiscalDoc {
  id          String       @id @default(cuid())
  orderId     String
  chargeId    String?
  kind        String // NFE ou NFSE
  provider    String
  externalId  String?      @unique
  number      String?
  series      String?
  accessKey   String?
  status      FiscalStatus @default(PENDENTE)
  pdfUrl      String?
  xmlUrl      String?
  error       String?
  emittedAt   DateTime?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  charge Charge? @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
}

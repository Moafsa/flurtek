# Copie para .env e preencha. NUNCA versione o .env nem cole chaves em chat.

# --- Banco de dados ---
POSTGRES_USER=flurtek
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=flurtek_crm
DATABASE_URL=postgresql://flurtek:troque-esta-senha@localhost:5442/flurtek_crm?schema=public

# --- Login e segredos ---
AUTH_SECRET=gere-com-openssl-rand-base64-32
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true
# Chave que criptografa segredos no banco (certificado A1, chave de IA). 32 bytes em base64:
#   openssl rand -base64 32      Faça backup: se mudar, é preciso enviar os segredos de novo.
APP_ENCRYPTION_KEY=
# Senha dos usuários de teste criados pelo seed (somente desenvolvimento)
SEED_PASSWORD=senha-de-teste-troque

# --- Site e formulários ---
SITE_URL=http://localhost:3100
INTAKE_SITE_KEY=chave-publica-do-site
INTAKE_ALLOWED_ORIGINS=http://localhost:3100

# --- WhatsApp (ConextBot) ---
CHANNEL_MODE=mock
CONEXTBOT_BASE_URL=https://app.conext.click
CONEXTBOT_API_KEY=
CONEXTBOT_WEBHOOK_TOKEN=token-do-webhook
CONEXTBOT_WEBHOOK_SECRET=

# --- IA do agente (também configurável pelo painel: Config > Inteligência artificial) ---
# LLM_PROVIDER: auto | openrouter | anthropic | mock
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_OWNER_MODEL=
OPENROUTER_DATA_COLLECTION=deny
ANTHROPIC_API_KEY=

# --- Financeiro (Asaas) ---
PAYMENT_MODE=mock
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- NF-e direto na SEFAZ (o certificado também pode ser enviado pelo painel) ---
SEFAZ_CERT_PATH=
SEFAZ_CERT_PASSWORD=
